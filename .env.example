# Supabase (existing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas servidor — recuperação de senha (Admin API). Nunca commitar em repositório público.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — só servidor (interpretação da Nyx). Nunca use NEXT_PUBLIC_.
OPENAI_API_KEY=

# Prisma / Postgres (Supabase)
# Em Vercel/serverless use o pooler (porta 6543), NÃO o host db.*.supabase.co:5432.
# Dashboard Supabase → Connect → Transaction pooler (Prisma):
# DATABASE_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# DIRECT_URL fica com a conexão direta (migrations/local):
# DIRECT_URL="postgresql://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres"
DATABASE_URL=
DIRECT_URL=
