# Supabase (existing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas servidor — recuperação de senha (Admin API). Nunca commitar em repositório público.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — só servidor (interpretação da Nyx). Nunca use NEXT_PUBLIC_.
OPENAI_API_KEY=

# Prisma — cole a URI em Supabase → Settings → Database → Connection string (URI).
# Host deve ser do mesmo projeto que NEXT_PUBLIC_SUPABASE_URL (ex.: db.[ref].supabase.co).
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.SEU_REF.supabase.co:5432/postgres"
